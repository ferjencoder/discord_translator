# Discord identity
DISCORD_TOKEN=replace_me
SERVER_ID=replace_me

# Dedicated language-channel webhooks
WEBHOOK_EN=https://discord.com/api/webhooks/000000000000000001/replace_me
WEBHOOK_ES=https://discord.com/api/webhooks/000000000000000002/replace_me
WEBHOOK_FR=https://discord.com/api/webhooks/000000000000000003/replace_me
WEBHOOK_PT=https://discord.com/api/webhooks/000000000000000004/replace_me
WEBHOOK_SV=https://discord.com/api/webhooks/000000000000000005/replace_me
WEBHOOK_DE=https://discord.com/api/webhooks/000000000000000006/replace_me
WEBHOOK_CEB=https://discord.com/api/webhooks/000000000000000007/replace_me
WEBHOOK_RU=https://discord.com/api/webhooks/000000000000000008/replace_me
WEBHOOK_AR=https://discord.com/api/webhooks/000000000000000009/replace_me
WEBHOOK_NO=https://discord.com/api/webhooks/000000000000000010/replace_me

# Render / health endpoint
PORT=10000
SELF_PING_ENABLED=true
SELF_PING_INTERVAL_SECONDS=600

# Translation provider - conservative defaults recommended for Render
TRANSLATION_CONCURRENCY=1
TRANSLATION_START_INTERVAL_SECONDS=1.5
TRANSLATION_RETRIES=2
TRANSLATION_CONNECT_TIMEOUT_SECONDS=5
TRANSLATION_READ_TIMEOUT_SECONDS=15
TRANSLATION_TASK_TIMEOUT_SECONDS=25
TRANSLATION_429_COOLDOWN_SECONDS=120
# Delay before switching from mobile HTML to JSON after parser/endpoint failure
TRANSLATION_FALLBACK_DELAY_SECONDS=10
# original = forward source text without noisy banner
# skip     = do not post failed destination copy
# marked   = old [Translation unavailable ...] behavior
TRANSLATION_FAILURE_MODE=original

# Translation telemetry / leadership status command
TRANSLATION_METRICS_RETENTION_DAYS=90
TRANSLATOR_STATUS_ROLE_NAMES=Leader,Superior,Superiors
# Cost estimator only - update these if Google Cloud pricing changes
GOOGLE_CLOUD_FREE_CHARS_MONTHLY=500000
GOOGLE_CLOUD_USD_PER_MILLION_CHARS=20

# Discord delivery
EVENT_QUEUE_SIZE=500
WEBHOOK_RETRIES=2
WEBHOOK_START_INTERVAL_SECONDS=0.50
WEBHOOK_429_COOLDOWN_SECONDS=10
WEBHOOK_MAX_RETRY_AFTER_SECONDS=30
WEBHOOK_QUARANTINE_SECONDS=300
WEBHOOK_SEND_TIMEOUT_SECONDS=15
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=25
SILENT_TRANSLATIONS=false
MAX_REUPLOAD_BYTES=8388608
MAX_TOTAL_REUPLOAD_BYTES=20971520

# Reaction translation for topic channels (optional)
REACTION_CHANNEL_IDS=
REACTION_CATEGORY_IDS=
REACTION_QUEUE_SIZE=100
REACTION_MAX_AGE_DAYS=7
REACTION_MAX_TRANSLATIONS_PER_MESSAGE=5
REACTION_MAX_SOURCE_CHARS=4000
REACTION_USER_REQUESTS_PER_MINUTE=15
SILENT_REACTION_TRANSLATIONS=true

# State
STATE_DB=replace_me
STATE_RETENTION_DAYS=30
